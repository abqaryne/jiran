<?xml version="1.0" encoding="utf-8"?>
<!-- Commute option: grey fill, and a 2 dp blue border when it is the highlighted (selected) one. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_bg_surface" />
            <stroke android:width="@dimen/stroke_selected" android:color="@color/color_brand_primary" />
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_bg_fill" />
            <corners android:radius="@dimen/radius_16" />
        </shape>
    </item>
</selector>
