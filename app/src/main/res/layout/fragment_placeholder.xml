<?xml version="1.0" encoding="utf-8"?>
<!-- Shared placeholder for tabs that are not built yet. Replace it per feature with the real layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_margin">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Jiran.Headline" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/coming_soon"
        android:textAppearance="@style/TextAppearance.Jiran.Meta" />
</LinearLayout>
