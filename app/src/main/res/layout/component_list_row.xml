<?xml version="1.0" encoding="utf-8"?>
<!--
  Figma: List row. Icon circle (or avatar), title, subtitle, trailing text or chevron.
  A thin divider sits under every row except the last (use bg_divider_bottom on the root, or an ItemDecoration).
  Min height 64 dp, whole row is the touch target.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_divider_bottom"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_row_min_height"
    android:orientation="horizontal"
    android:paddingTop="@dimen/spacing_12"
    android:paddingBottom="@dimen/spacing_12">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/avatar_medium"
        android:layout_height="@dimen/avatar_medium"
        android:background="@drawable/bg_icon_circle"
        android:contentDescription="@null"
        android:padding="9dp"
        app:tint="@color/color_text_primary"
        tools:srcCompat="@tools:sample/avatars" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_marginEnd="@dimen/spacing_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:textAppearance="@style/TextAppearance.Jiran.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="TNB electricity" />

        <TextView
            android:id="@+id/subtitle"
            android:textAppearance="@style/TextAppearance.Jiran.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Paid by Aisyah · split equally" />
    </LinearLayout>

    <TextView
        android:id="@+id/trailing"
        android:textAppearance="@style/TextAppearance.Jiran.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="RM 186" />
</LinearLayout>
