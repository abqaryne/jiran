<?xml version="1.0" encoding="utf-8"?>
<!--
  Jiran type scale. Font is Geist, semibold at most (never bold). Sizes in sp so users can scale text.
  Line heights are set in values-v28/type.xml (android:lineHeight needs Android 9); Android 8 uses the default spacing.
  To change a size or line height, edit it here AND in values-v28/type.xml (they must match the Figma text styles).
-->
<resources>
    <style name="TextAppearance.Jiran" parent="">
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.Jiran.Display.Base" parent="TextAppearance.Jiran">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>
    <style name="TextAppearance.Jiran.Display" parent="TextAppearance.Jiran.Display.Base" />

    <style name="TextAppearance.Jiran.Headline.Base" parent="TextAppearance.Jiran">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="TextAppearance.Jiran.Headline" parent="TextAppearance.Jiran.Headline.Base" />

    <style name="TextAppearance.Jiran.Section.Base" parent="TextAppearance.Jiran">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.Jiran.Section" parent="TextAppearance.Jiran.Section.Base" />

    <style name="TextAppearance.Jiran.Title.Base" parent="TextAppearance.Jiran">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">17sp</item>
        </style>
    <style name="TextAppearance.Jiran.Title" parent="TextAppearance.Jiran.Title.Base" />

    <style name="TextAppearance.Jiran.Body.Base" parent="TextAppearance.Jiran">
        <item name="android:fontFamily">@font/geist_regular</item>
        <item name="android:textSize">16sp</item>
        </style>
    <style name="TextAppearance.Jiran.Body" parent="TextAppearance.Jiran.Body.Base" />

    <style name="TextAppearance.Jiran.Label.Base" parent="TextAppearance.Jiran">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">16sp</item>
        </style>
    <style name="TextAppearance.Jiran.Label" parent="TextAppearance.Jiran.Label.Base" />

    <style name="TextAppearance.Jiran.LabelSmall.Base" parent="TextAppearance.Jiran">
        <item name="android:fontFamily">@font/geist_semibold</item>
        <item name="android:textSize">14sp</item>
        </style>
    <style name="TextAppearance.Jiran.LabelSmall" parent="TextAppearance.Jiran.LabelSmall.Base" />

    <style name="TextAppearance.Jiran.Meta.Base" parent="TextAppearance.Jiran">
        <item name="android:fontFamily">@font/geist_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>
    <style name="TextAppearance.Jiran.Meta" parent="TextAppearance.Jiran.Meta.Base" />

    <style name="TextAppearance.Jiran.Caption.Base" parent="TextAppearance.Jiran">
        <item name="android:fontFamily">@font/geist_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>
    <style name="TextAppearance.Jiran.Caption" parent="TextAppearance.Jiran.Caption.Base" />
</resources>
