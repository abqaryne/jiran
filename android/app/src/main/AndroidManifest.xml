<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".JiranApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ui.EmailPasswordActivity" android:exported="false" />
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:theme="@style/Theme.Jiran"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.CommutePreviewActivity" android:exported="false" />
        <activity android:name=".ui.MatchPreviewActivity" android:exported="false" />
        <!-- Product shell (tabs + navigation). Not launched yet: Ary wires it in after sign-in. -->
        <activity
            android:name=".ui.shell.ShellActivity"
            android:exported="false"
            android:theme="@style/Theme.Jiran" />
        <!-- Developer screen from the backend foundation. Debug builds open it from the "Jiran dev" launcher icon. -->
        <activity android:name=".ui.MainActivity" android:exported="true" />
        <!-- The front door: reads the saved session and opens Welcome, Verify email or the product. -->
        <activity
            android:name=".ui.auth.LauncherActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.Jiran">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
