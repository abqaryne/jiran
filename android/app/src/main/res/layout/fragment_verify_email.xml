<?xml version="1.0" encoding="utf-8"?>
<!-- Figma: Verify email. Mail icon, message, tip, then Open email app, Resend link and Change email. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_16"
            android:paddingEnd="@dimen/screen_margin">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back"
                style="@style/Widget.Jiran.IconButton.Soft"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:contentDescription="@string/auth_back"
                app:icon="@drawable/ic_arrow_back" />

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_32"
                android:background="@drawable/bg_circle_tint">

                <ImageView
                    android:layout_width="@dimen/icon_size"
                    android:layout_height="@dimen/icon_size"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_mark_email_unread"
                    app:tint="@color/color_brand_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:gravity="center"
                android:text="@string/auth_verify_title"
                android:textAppearance="@style/TextAppearance.Jiran.Headline" />

            <TextView
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Jiran.Body"
                android:textColor="@color/color_text_secondary" />

            <com.jiran.app.ui.common.InfoBannerView
                android:id="@+id/tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                app:bannerKind="info"
                app:bannerText="@string/auth_verify_tip" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_email"
            style="@style/Widget.Jiran.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_verify_open_email" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resend"
            style="@style/Widget.Jiran.Button.Soft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/auth_verify_resend" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/change_email"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:text="@string/auth_verify_change_email"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.Jiran.Label"
            android:textColor="@color/color_brand_primary" />
    </LinearLayout>
</LinearLayout>
