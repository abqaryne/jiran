<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_surface"
    tools:context=".ui.shell.ShellActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_main"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- Floating tab bar + Post button (design system view) -->
    <com.jiran.app.ui.common.JiranTabBar
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <!-- Shown when the profile check fails (E1.3 gate fails closed): message and a retry button. -->
    <LinearLayout
        android:id="@+id/gate_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_bg_surface"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24"
        android:visibility="gone">

        <TextView
            android:id="@+id/gate_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Jiran.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gate_retry"
            style="@style/Widget.Jiran.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="@string/shell_gate_retry" />
    </LinearLayout>
</FrameLayout>
