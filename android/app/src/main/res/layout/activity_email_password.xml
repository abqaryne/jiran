<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/auth_title" android:textSize="24sp" />
        <TextView android:id="@+id/auth_environment" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <TextView android:id="@+id/auth_session" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/auth_email" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:inputType="textEmailAddress" android:autofillHints="emailAddress"
            android:hint="@string/auth_email" />
        <EditText android:id="@+id/auth_password" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:inputType="textPassword" android:autofillHints="password"
            android:hint="@string/auth_password" />
        <Button android:id="@+id/auth_register" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/auth_register" />
        <Button android:id="@+id/auth_sign_in" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/auth_sign_in" />
        <Button android:id="@+id/auth_reset" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/auth_reset" />
        <Button android:id="@+id/auth_verify" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/auth_verify" />
        <Button android:id="@+id/auth_refresh" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/auth_refresh" />
        <Button android:id="@+id/auth_firestore" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/auth_firestore" />
        <Button android:id="@+id/auth_sign_out" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/auth_sign_out" />
        <TextView android:id="@+id/auth_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
