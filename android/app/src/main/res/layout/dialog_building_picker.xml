<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/spacing_16">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/close"
                style="@style/Widget.Jiran.IconButton.Soft"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_gravity="end"
                android:contentDescription="@string/building_picker_close"
                app:icon="@drawable/ic_close" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/building_picker_title"
                android:textAppearance="@style/TextAppearance.Jiran.Section" />
            <com.jiran.app.ui.common.InfoBannerView
                android:id="@+id/location_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:bannerKind="info" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/building_layout"
                style="@style/Widget.Jiran.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:hint="@string/building_picker_name">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/building_name"
                    style="@style/Widget.Jiran.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:inputType="textCapWords"
                    android:maxLength="200"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Jiran.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:hint="@string/building_picker_area"
                app:endIconMode="dropdown_menu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/field_height"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingEnd="@dimen/spacing_16"
                    android:completionThreshold="1"
                    android:inputType="textCapWords"
                    android:maxLength="200"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Jiran.Body" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.jiran.app.ui.common.InfoBannerView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:accessibilityLiveRegion="polite"
                app:bannerKind="info" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry"
                style="@style/Widget.Jiran.Button.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="@string/building_picker_retry"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirm"
        style="@style/Widget.Jiran.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:enabled="false"
        android:text="@string/building_picker_confirm" />
</LinearLayout>
