<?xml version="1.0" encoding="utf-8"?>
<!--
  Figma "Profile 3 · Privacy": three switch rows (on = hidden), the info banner, Finish. Security Rules read the
  phone switch; see PrivacyStepFragment for what each switch stores.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_16"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/spacing_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_privacy_title"
                android:textAppearance="@style/TextAppearance.Jiran.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/profile_privacy_subtitle"
                android:textAppearance="@style/TextAppearance.Jiran.Body"
                android:textColor="@color/color_text_secondary" />

            <include
                android:id="@+id/phone_row"
                layout="@layout/item_profile_switch_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16" />

            <include
                android:id="@+id/budget_row"
                layout="@layout/item_profile_switch_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/photo_row"
                layout="@layout/item_profile_switch_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.jiran.app.ui.common.InfoBannerView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:bannerKind="info"
                app:bannerText="@string/profile_privacy_note" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_divider_top"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_12"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_24">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next"
            style="@style/Widget.Jiran.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_finish" />
    </FrameLayout>
</LinearLayout>
