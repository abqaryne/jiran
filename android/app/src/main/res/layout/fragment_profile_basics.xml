<?xml version="1.0" encoding="utf-8"?>
<!--
  Figma "Profile 1 · Faculty": heading, faculty search field, Popular faculty chips, Year of study chips, Next.
  Gender (required since 31 Oct 2026) and the name field (only when sign-up stored no name) are added below.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_16"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/spacing_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_basics_title"
                android:textAppearance="@style/TextAppearance.Jiran.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/profile_basics_subtitle"
                android:textAppearance="@style/TextAppearance.Jiran.Body"
                android:textColor="@color/color_text_secondary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/name_layout"
                style="@style/Widget.Jiran.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:hint="@string/profile_field_name"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/name"
                    style="@style/Widget.Jiran.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/faculty_search_layout"
                style="@style/Widget.Jiran.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:hint="@string/profile_field_faculty_search">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/faculty_search"
                    style="@style/Widget.Jiran.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="1"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/faculty_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/profile_faculty_popular"
                android:textAppearance="@style/TextAppearance.Jiran.Label" />

            <!-- Offset the 6 dp touch inset: 36 dp chip + 8 dp visible gap, with 48 dp touch bounds. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/faculty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="-6dp"
                app:chipSpacingHorizontal="@dimen/spacing_8"
                app:chipSpacingVertical="-4dp"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/faculty_error"
                style="@style/Widget.Jiran.ProfileFieldError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_error_choose_one" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/profile_year"
                android:textAppearance="@style/TextAppearance.Jiran.Label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="-6dp"
                app:chipSpacingHorizontal="@dimen/spacing_8"
                app:chipSpacingVertical="-4dp"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/year_error"
                style="@style/Widget.Jiran.ProfileFieldError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_error_choose_one" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/profile_gender"
                android:textAppearance="@style/TextAppearance.Jiran.Label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="-6dp"
                app:chipSpacingVertical="-4dp"
                app:chipSpacingHorizontal="@dimen/spacing_8"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Jiran.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="male"
                    android:text="@string/profile_gender_male" />

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Jiran.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="female"
                    android:text="@string/profile_gender_female" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/gender_error"
                style="@style/Widget.Jiran.ProfileFieldError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_error_choose_one" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_divider_top"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_12"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_24">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next"
            style="@style/Widget.Jiran.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_next" />
    </FrameLayout>
</LinearLayout>
