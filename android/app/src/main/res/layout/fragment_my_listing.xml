<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/color_bg_surface" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/screen_margin">
        <com.google.android.material.button.MaterialButton android:id="@+id/my_listing_back"
            style="@style/Widget.Jiran.Button.Soft" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:text="@string/my_listing_back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Jiran.Headline" android:text="@string/my_listing_title" />
        <com.jiran.app.ui.common.InfoBannerView android:id="@+id/my_listing_sample"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
            android:layout_marginTop="@dimen/spacing_16" />
        <com.jiran.app.ui.common.InfoBannerView android:id="@+id/my_listing_feedback"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" android:layout_marginTop="@dimen/spacing_16" />
        <com.google.android.material.button.MaterialButton android:id="@+id/my_listing_refresh"
            style="@style/Widget.Jiran.Button.Soft" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min" android:text="@string/my_listing_refresh" />
        <LinearLayout android:id="@+id/my_listing_content" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/my_listing_building" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Jiran.Section" />
            <com.jiran.app.ui.common.InfoBannerView android:id="@+id/my_listing_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16" />
            <com.google.android.material.button.MaterialButton android:id="@+id/my_listing_renew"
                style="@style/Widget.Jiran.Button.Primary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/spacing_16" android:text="@string/my_listing_renew" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24" android:textAppearance="@style/TextAppearance.Jiran.Title"
                android:text="@string/my_listing_rooms" />
            <LinearLayout android:id="@+id/my_listing_rooms" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24" android:textAppearance="@style/TextAppearance.Jiran.Title"
                android:text="@string/my_listing_requests" />
            <LinearLayout android:id="@+id/my_listing_requests" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
