<?xml version="1.0" encoding="utf-8"?>
<!--
  Figma: Tab bar + Post button. A floating white pill with four tabs (Home, Rooms, Match, Unit) and a blue Post button beside it.
  Use it through JiranTabBar. The selected tab gets the filled icon and ink colour. Content above needs ~96 dp bottom padding.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/spacing_16"
    android:paddingEnd="@dimen/spacing_16"
    android:paddingBottom="@dimen/spacing_16">

    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tab_bar_height"
        android:layout_gravity="bottom|start"
        android:background="@drawable/bg_tab_bar"
        android:elevation="@dimen/elevation_floating"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_4">

        <LinearLayout
            android:id="@+id/tab_home"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/home_title"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_tab_home"
                app:tint="@color/tab_item_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_title"
                android:textAppearance="@style/TextAppearance.Jiran.Caption"
                android:textColor="@color/tab_item_color" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_rooms"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/rooms_title"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_tab_bed"
                app:tint="@color/tab_item_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rooms_title"
                android:textAppearance="@style/TextAppearance.Jiran.Caption"
                android:textColor="@color/tab_item_color" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_match"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/match_title"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_tab_group"
                app:tint="@color/tab_item_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/match_title"
                android:textAppearance="@style/TextAppearance.Jiran.Caption"
                android:textColor="@color/tab_item_color" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_unit"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/unit_title"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_tab_door_front"
                app:tint="@color/tab_item_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_title"
                android:textAppearance="@style/TextAppearance.Jiran.Caption"
                android:textColor="@color/tab_item_color" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/post_button"
        style="@style/Widget.Jiran.FloatingActionButton.Post"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:contentDescription="@string/tab_post"
        app:srcCompat="@drawable/ic_add" />
</FrameLayout>
