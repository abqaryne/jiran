<?xml version="1.0" encoding="utf-8"?>
<!--
  Figma: setup row with a switch. Icon circle (40 dp), title, subtitle, switch on the right.
  Used for "I own a car" and the privacy switches; the fragments set the icon and texts.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_row_min_height"
    android:orientation="horizontal"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:background="@drawable/bg_icon_circle"
        android:contentDescription="@null"
        android:padding="9dp"
        app:tint="@color/color_text_primary"
        tools:srcCompat="@drawable/ic_directions_car" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="@dimen/spacing_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Jiran.Label"
            tools:text="I own a car" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Jiran.Meta"
            android:textColor="@color/color_text_secondary"
            tools:text="Adds driving to your commute options" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/toggle"
        style="@style/Widget.Jiran.Switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min" />
</LinearLayout>
