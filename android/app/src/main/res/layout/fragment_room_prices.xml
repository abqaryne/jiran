<?xml version="1.0" encoding="utf-8"?>
<!--
  E2.2, Figma "Listing · Rooms and prices": top bar with back and the centred title, step 2 of 3,
  Unit rent and Deposit from step 1 (read only here), allocation head and bar, compact Room rows,
  the over-allocation banner, the suggested split, and the footer action.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/room_prices_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/room_prices_back"
                style="@style/Widget.Jiran.IconButton.Soft"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:contentDescription="@string/post_back"
                app:icon="@drawable/ic_arrow_back" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/room_prices_title"
            android:textAppearance="@style/TextAppearance.Jiran.Title" />

        <Space
            android:layout_width="104dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/room_prices_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/room_prices_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_8"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/spacing_24">

            <com.jiran.app.ui.common.StepProgressView
                android:id="@+id/room_prices_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:stepCurrent="2"
                app:stepTotal="3" />

            <com.jiran.app.ui.common.InfoBannerView
                android:id="@+id/room_prices_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:accessibilityLiveRegion="polite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/room_prices_reload"
                style="@style/Widget.Jiran.Button.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/room_prices_reload"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/room_prices_rent_layout"
                    style="@style/Widget.Jiran.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/room_prices_rent_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/room_prices_rent"
                        style="@style/Widget.Jiran.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:longClickable="false"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/room_prices_deposit_layout"
                    style="@style/Widget.Jiran.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_12"
                    android:layout_weight="1"
                    android:hint="@string/room_prices_deposit_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/room_prices_deposit"
                        style="@style/Widget.Jiran.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:longClickable="false"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/room_prices_rent_help"
                android:textAppearance="@style/TextAppearance.Jiran.Meta" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/room_prices_heading"
                    android:textAppearance="@style/TextAppearance.Jiran.Label" />

                <TextView
                    android:id="@+id/room_prices_allocated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.Jiran.Label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/room_prices_bar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="@dimen/spacing_12"
                android:importantForAccessibility="no"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/room_price_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/room_prices_add"
                style="@style/Widget.Jiran.Button.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/room_prices_add"
                app:icon="@drawable/ic_add"
                app:iconTint="@color/color_text_primary" />

            <com.jiran.app.ui.common.InfoBannerView
                android:id="@+id/room_prices_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:accessibilityLiveRegion="polite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/room_prices_apply"
                style="@style/Widget.Jiran.Button.Soft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:minHeight="@dimen/touch_target_min"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/room_prices_apply"
                android:textColor="@color/color_brand_primary"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_auto_awesome"
                app:iconTint="@color/color_brand_primary" />

            <TextView
                android:id="@+id/room_prices_estimate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Jiran.Meta" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/room_prices_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_divider_top"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_12"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_24">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/room_prices_save"
            style="@style/Widget.Jiran.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/room_prices_save" />
    </FrameLayout>
</LinearLayout>
