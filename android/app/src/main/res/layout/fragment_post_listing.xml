<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/post_scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/color_bg_surface" android:fillViewport="true">
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/spacing_16">
        <com.google.android.material.button.MaterialButton android:id="@+id/back"
            style="@style/Widget.Jiran.Button.Soft" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/post_back" app:icon="@drawable/ic_arrow_back" app:iconTint="@color/color_text_primary"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16" android:text="@string/post_title"
            android:textAppearance="@style/TextAppearance.Jiran.Headline"/>
        <com.jiran.app.ui.common.InfoBannerView android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16" android:accessibilityLiveRegion="polite"
            app:bannerText="@string/post_intro"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24" android:text="@string/post_photos"
            android:textAppearance="@style/TextAppearance.Jiran.Section"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/post_photo_help" android:textAppearance="@style/TextAppearance.Jiran.Meta"/>
        <LinearLayout android:id="@+id/photos" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/add_photo"
            style="@style/Widget.Jiran.Button.Soft" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/post_add_photo" app:icon="@drawable/ic_image" app:iconTint="@color/color_text_primary"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/building"
            style="@style/Widget.Jiran.Button.Soft" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24" android:text="@string/post_choose_building"
            app:icon="@drawable/ic_apartment" app:iconTint="@color/color_text_primary"/>
        <TextView android:id="@+id/building_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/post_building_help" android:textAppearance="@style/TextAppearance.Jiran.Body"/>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/address_layout"
            style="@style/Widget.Jiran.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16" android:hint="@string/post_address">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/address"
                style="@style/Widget.Jiran.TextInputEditText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPostalAddress" android:maxLength="500" android:saveEnabled="false"
                android:importantForAutofill="no"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8" android:text="@string/post_private_help"
            android:textAppearance="@style/TextAppearance.Jiran.Meta"/>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/rent_layout"
            style="@style/Widget.Jiran.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16" android:hint="@string/post_rent">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/rent"
                style="@style/Widget.Jiran.TextInputEditText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="numberDecimal" android:maxLength="18" android:saveEnabled="false"
                android:importantForAutofill="no"/>
        </com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/deposit_layout"
            style="@style/Widget.Jiran.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16" android:hint="@string/post_deposit">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/deposit"
                style="@style/Widget.Jiran.TextInputEditText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="numberDecimal" android:maxLength="18" android:saveEnabled="false"
                android:importantForAutofill="no"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24" android:text="@string/post_gender"
            android:textAppearance="@style/TextAppearance.Jiran.Title"/>
        <com.google.android.material.chip.ChipGroup android:id="@+id/gender"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/any"
                style="@style/Widget.Jiran.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/post_any" android:checkable="true" app:ensureMinTouchTargetSize="true"
                app:chipMinTouchTargetSize="@dimen/touch_target_min"/>
<com.google.android.material.chip.Chip android:id="@+id/male"
                style="@style/Widget.Jiran.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/post_male" android:checkable="true" app:ensureMinTouchTargetSize="true"
                app:chipMinTouchTargetSize="@dimen/touch_target_min"/>
<com.google.android.material.chip.Chip android:id="@+id/female"
                style="@style/Widget.Jiran.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/post_female" android:checkable="true" app:ensureMinTouchTargetSize="true"
                app:chipMinTouchTargetSize="@dimen/touch_target_min"/>
        </com.google.android.material.chip.ChipGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16" android:text="@string/post_amenities"
            android:textAppearance="@style/TextAppearance.Jiran.Title"/>
        <com.google.android.material.chip.ChipGroup android:id="@+id/amenities"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.chip.Chip android:id="@+id/wifi"
                style="@style/Widget.Jiran.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/post_wifi" android:checkable="true" app:ensureMinTouchTargetSize="true"
                app:chipMinTouchTargetSize="@dimen/touch_target_min"/>
<com.google.android.material.chip.Chip android:id="@+id/aircon"
                style="@style/Widget.Jiran.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/post_aircon" android:checkable="true" app:ensureMinTouchTargetSize="true"
                app:chipMinTouchTargetSize="@dimen/touch_target_min"/>
<com.google.android.material.chip.Chip android:id="@+id/washing_machine"
                style="@style/Widget.Jiran.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/post_washing" android:checkable="true" app:ensureMinTouchTargetSize="true"
                app:chipMinTouchTargetSize="@dimen/touch_target_min"/>
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.button.MaterialButton android:id="@+id/save"
            style="@style/Widget.Jiran.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_24" android:text="@string/post_save"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
