<?xml version="1.0" encoding="utf-8"?>
<!--
  Jiran colour tokens. Names match the Figma variables 1:1 (see docs/design/DESIGN.md).
  Primitives are raw values. Use ONLY the semantic color_* names in layouts and styles.
-->
<resources>
    <!-- Primitives: brand scale (brand_600 is the one brand blue) -->
    <color name="brand_50">#EEF5FE</color>
    <color name="brand_100">#D9E8FC</color>
    <color name="brand_200">#B4D1F8</color>
    <color name="brand_300">#82B2F1</color>
    <color name="brand_400">#4A8CE6</color>
    <color name="brand_500">#1F6FD6</color>
    <color name="brand_600">#065BC3</color>
    <color name="brand_700">#054A9E</color>
    <color name="brand_800">#063B7C</color>
    <color name="brand_900">#082E5F</color>

    <!-- Primitives: neutrals -->
    <color name="neutral_ink">#0B0B0C</color>
    <color name="neutral_secondary">#5B5F66</color>
    <color name="neutral_border_strong">#868B94</color>
    <color name="neutral_divider">#E6E7EA</color>
    <color name="neutral_fill">#EDEEF0</color>
    <color name="neutral_ground">#F3F4F6</color>
    <color name="neutral_white">#FFFFFF</color>

    <!-- Primitives: status (colour is never the only signal: always add a word and an icon) -->
    <color name="status_success_text">#0E7A3F</color>
    <color name="status_success_bg">#E3F4EA</color>
    <color name="status_warning_text">#8A5A00</color>
    <color name="status_warning_bg">#FFF1D6</color>
    <color name="status_danger_text">#B42318</color>
    <color name="status_danger_bg">#FDE7E5</color>

    <!-- Semantic: brand -->
    <color name="color_brand_primary">@color/brand_600</color>
    <color name="color_brand_pressed">@color/brand_700</color>
    <color name="color_brand_tint">@color/brand_50</color>
    <color name="color_brand_tint_strong">@color/brand_100</color>
    <color name="color_brand_on_tint">@color/brand_700</color>

    <!-- Semantic: text -->
    <color name="color_text_primary">@color/neutral_ink</color>
    <color name="color_text_secondary">@color/neutral_secondary</color>
    <color name="color_text_on_brand">@color/neutral_white</color>

    <!-- Semantic: borders and backgrounds -->
    <color name="color_border_strong">@color/neutral_border_strong</color>
    <color name="color_border_divider">@color/neutral_divider</color>
    <color name="color_bg_surface">@color/neutral_white</color>
    <color name="color_bg_ground">@color/neutral_ground</color>
    <color name="color_bg_fill">@color/neutral_fill</color>
    <color name="color_bg_ink">@color/neutral_ink</color>

    <!-- Semantic: status -->
    <color name="color_status_success_text">@color/status_success_text</color>
    <color name="color_status_success_bg">@color/status_success_bg</color>
    <color name="color_status_warning_text">@color/status_warning_text</color>
    <color name="color_status_warning_bg">@color/status_warning_bg</color>
    <color name="color_status_danger_text">@color/status_danger_text</color>
    <color name="color_status_danger_bg">@color/status_danger_bg</color>
</resources>
