<?xml version="1.0" encoding="utf-8"?>
<!--
  Jiran component styles. One style per Figma component or variant.
  Figma name -> Android style is listed in docs/design/DESIGN.md. Do not hard-code colours or sizes in layouts: use these.
-->
<resources>

    <!-- ===== Button (Figma: Button, Style x Size). Pill, 52 dp large / 40 dp small. ===== -->
    <style name="Widget.Jiran.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height_large</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/button_padding_large</item>
        <item name="android:paddingEnd">@dimen/button_padding_large</item>
        <item name="android:textAppearance">@style/TextAppearance.Jiran.Label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.Jiran.Button.Primary">
        <item name="backgroundTint">@color/btn_bg_primary</item>
        <item name="android:textColor">@color/btn_text_on_brand</item>
    </style>
    <style name="Widget.Jiran.Button.Ink">
        <item name="backgroundTint">@color/btn_bg_ink</item>
        <item name="android:textColor">@color/btn_text_on_brand</item>
    </style>
    <style name="Widget.Jiran.Button.Soft">
        <item name="backgroundTint">@color/btn_bg_soft</item>
        <item name="android:textColor">@color/btn_text_soft</item>
    </style>
    <!-- Small modifiers: top bar and inline actions -->
    <style name="Widget.Jiran.Button.Primary.Small">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:paddingStart">@dimen/button_padding_small</item>
        <item name="android:paddingEnd">@dimen/button_padding_small</item>
        <item name="android:textAppearance">@style/TextAppearance.Jiran.LabelSmall</item>
    </style>
    <style name="Widget.Jiran.Button.Ink.Small">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:paddingStart">@dimen/button_padding_small</item>
        <item name="android:paddingEnd">@dimen/button_padding_small</item>
        <item name="android:textAppearance">@style/TextAppearance.Jiran.LabelSmall</item>
    </style>
    <style name="Widget.Jiran.Button.Soft.Small">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:paddingStart">@dimen/button_padding_small</item>
        <item name="android:paddingEnd">@dimen/button_padding_small</item>
        <item name="android:textAppearance">@style/TextAppearance.Jiran.LabelSmall</item>
    </style>

    <!-- ===== Icon button (Figma: Icon button, Style = Soft / Outline / Ink / Brand). 40 dp circle. ===== -->
    <style name="Widget.Jiran.IconButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minWidth">@dimen/icon_button_size</item>
        <item name="android:minHeight">@dimen/icon_button_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Jiran.IconButton.Soft">
        <item name="backgroundTint">@color/color_bg_fill</item>
        <item name="iconTint">@color/color_text_primary</item>
    </style>
    <style name="Widget.Jiran.IconButton.Outline">
        <item name="backgroundTint">@color/color_bg_surface</item>
        <item name="iconTint">@color/color_text_primary</item>
        <item name="strokeColor">@color/color_border_divider</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
    </style>
    <style name="Widget.Jiran.IconButton.Ink">
        <item name="backgroundTint">@color/color_bg_ink</item>
        <item name="iconTint">@color/color_text_on_brand</item>
    </style>
    <style name="Widget.Jiran.IconButton.Brand">
        <item name="backgroundTint">@color/color_brand_primary</item>
        <item name="iconTint">@color/color_text_on_brand</item>
    </style>

    <!-- ===== Chip (Figma: Chip, Selected = False / True). 8 dp corners, ink border when selected. ===== -->
    <style name="Widget.Jiran.Chip.Filter" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipCornerRadius">@dimen/radius_8</item>
        <item name="chipBackgroundColor">@color/color_bg_surface</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <!-- Android cannot change stroke width per state: we use 1.5 dp for both states. Selected is also ink-coloured. -->
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Jiran.LabelSmall</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <!-- ===== Badge (Figma: Badge, Status). Always a word plus an icon, never colour alone. ===== -->
    <style name="Widget.Jiran.Badge" parent="">
        <item name="android:minHeight">@dimen/badge_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/spacing_8</item>
        <item name="android:paddingEnd">@dimen/spacing_8</item>
        <item name="android:drawablePadding">@dimen/spacing_4</item>
        <item name="android:textAppearance">@style/TextAppearance.Jiran.Caption</item>
    </style>
    <style name="Widget.Jiran.Badge.Success">
        <item name="android:background">@drawable/bg_badge_success</item>
        <item name="android:textColor">@color/color_status_success_text</item>
        <item name="android:drawableTint">@color/color_status_success_text</item>
    </style>
    <style name="Widget.Jiran.Badge.Warning">
        <item name="android:background">@drawable/bg_badge_warning</item>
        <item name="android:textColor">@color/color_status_warning_text</item>
        <item name="android:drawableTint">@color/color_status_warning_text</item>
    </style>
    <style name="Widget.Jiran.Badge.Danger">
        <item name="android:background">@drawable/bg_badge_danger</item>
        <item name="android:textColor">@color/color_status_danger_text</item>
        <item name="android:drawableTint">@color/color_status_danger_text</item>
    </style>
    <style name="Widget.Jiran.Badge.Brand">
        <item name="android:background">@drawable/bg_badge_brand</item>
        <item name="android:textColor">@color/color_brand_on_tint</item>
        <item name="android:drawableTint">@color/color_brand_on_tint</item>
    </style>
    <style name="Widget.Jiran.Badge.Neutral">
        <item name="android:background">@drawable/bg_badge_neutral</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:drawableTint">@color/color_text_primary</item>
    </style>

    <!-- ===== Avatar (Figma: Avatar, Size). Initials on a soft blue circle. Set layout_width and layout_height to the avatar_* dimen. ===== -->
    <style name="Widget.Jiran.Avatar" parent="">
        <item name="android:background">@drawable/bg_avatar</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/color_brand_on_tint</item>
        <item name="android:textAppearance">@style/TextAppearance.Jiran.LabelSmall</item>
    </style>
    <style name="Widget.Jiran.Avatar.Small">
        <item name="android:minWidth">@dimen/avatar_small</item>
        <item name="android:minHeight">@dimen/avatar_small</item>
    </style>
    <style name="Widget.Jiran.Avatar.Medium">
        <item name="android:minWidth">@dimen/avatar_medium</item>
        <item name="android:minHeight">@dimen/avatar_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.Jiran.Title</item>
    </style>
    <style name="Widget.Jiran.Avatar.Large">
        <item name="android:minWidth">@dimen/avatar_large</item>
        <item name="android:minHeight">@dimen/avatar_large</item>
        <item name="android:textAppearance">@style/TextAppearance.Jiran.Section</item>
    </style>

    <!-- ===== Field (Figma: Field, State = Default / Focused / Error). 12 dp outline, ink 2 dp when focused, red when error. ===== -->
    <style name="Widget.Jiran.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_12</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_12</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_12</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_12</item>
        <item name="boxBackgroundColor">@color/color_bg_surface</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">@dimen/stroke_thin</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_selected</item>
        <item name="boxStrokeErrorColor">@color/color_status_danger_text</item>
        <item name="errorTextColor">@color/color_status_danger_text</item>
        <item name="hintTextColor">@color/color_text_secondary</item>
        <item name="android:textColorHint">@color/color_text_secondary</item>
        <item name="hintTextAppearance">@style/TextAppearance.Jiran.Caption</item>
        <item name="errorTextAppearance">@style/TextAppearance.Jiran.Caption</item>
    </style>
    <style name="Widget.Jiran.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textAppearance">@style/TextAppearance.Jiran.Body</item>
    </style>

    <!-- ===== Search bar (Figma: Search bar). 44 dp pill with a grey outline. Put an icon and an EditText inside. ===== -->
    <style name="Widget.Jiran.SearchBar" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/color_bg_surface</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="strokeColor">@color/color_border_strong</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
    </style>

    <!-- ===== Cards: white with a 1 dp divider edge, no shadow ===== -->
    <style name="Widget.Jiran.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/color_bg_surface</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/radius_12</item>
        <item name="strokeColor">@color/color_border_divider</item>
        <item name="strokeWidth">@dimen/stroke_thin</item>
    </style>
    <!-- Info banner: soft blue, no border -->
    <style name="Widget.Jiran.Card.Info">
        <item name="cardBackgroundColor">@color/color_brand_tint</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <!-- Grouped card on the grey ground (Household dashboard) -->
    <style name="Widget.Jiran.Card.Grouped">
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ===== Top bar: 60 dp, centred Title, back button on the left ===== -->
    <style name="Widget.Jiran.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:minHeight">@dimen/top_bar_height</item>
        <item name="android:background">@color/color_bg_surface</item>
        <item name="titleTextAppearance">@style/TextAppearance.Jiran.Title</item>
        <item name="titleCentered">true</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- ===== Switch (Figma: Select row switch) ===== -->
    <style name="Widget.Jiran.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="trackTint">@color/switch_track</item>
        <item name="thumbTint">@color/color_bg_surface</item>
    </style>

    <!-- ===== Bottom sheet: 16 dp top corners, grabber on top ===== -->
    <style name="Widget.Jiran.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/color_bg_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Jiran.BottomSheet</item>
    </style>

    <!-- ===== Post button (Figma: Post button). 60 dp blue circle with a floating shadow. ===== -->
    <style name="Widget.Jiran.FloatingActionButton.Post" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/color_brand_primary</item>
        <item name="tint">@color/color_text_on_brand</item>
        <item name="fabCustomSize">@dimen/post_button_size</item>
        <item name="maxImageSize">@dimen/icon_size</item>
        <item name="elevation">@dimen/elevation_floating</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Jiran.Pill</item>
    </style>
</resources>
